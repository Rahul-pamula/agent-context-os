{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated structural subset. contextos.bundle_schema is authoritative for exact keys, portable paths, compatibility, source verification, and digests.",
  "title": "Context OS detached bundle lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle",
    "bundle_sha256",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatibility",
        "component_manifest_path",
        "files",
        "name",
        "source_git_commit",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_git_commit": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "component_manifest_path": {
          "const": "components/manifest.json"
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component_manifest_schema",
            "planner_protocol",
            "runtime_descriptor_schema",
            "workspace_schema"
          ],
          "properties": {
            "component_manifest_schema": {
              "const": 1
            },
            "runtime_descriptor_schema": {
              "const": 2
            },
            "workspace_schema": {
              "const": 1
            },
            "planner_protocol": {
              "const": 1
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "executable",
              "path",
              "sha256_raw",
              "size"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256_raw": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "executable": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
